{
  "name": "Weather Ingestion",
  "nodes": [
    {
      "parameters": {
        "rule": "hourly"
      },
      "name": "Cron trigger",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "https://power.larc.nasa.gov/api/temporal/daily/point",
        "options": {}
      },
      "name": "Fetch NASA POWER",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/webhook/weather-update",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-N8N-Secret",
              "value": "sih_skey_2026"
            }
          ]
        },
        "options": {}
      },
      "name": "Push to Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [650, 300]
    }
  ],
  "connections": {
    "Cron trigger": {
      "main": [
        [
          {
            "node": "Fetch NASA POWER",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch NASA POWER": {
      "main": [
        [
          {
            "node": "Push to Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
