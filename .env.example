# Database connection URL (defaults to local SQLite if empty)
DATABASE_URL=sqlite+aiosqlite:///./terramind_x.db

# NVIDIA NIM configurations (obtain from build.nvidia.com)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Government data.gov.in API key (obtain from data.gov.in)
DATA_GOV_API_KEY=

# Government resource IDs (leave empty to use default internal mock handlers when API is unavailable)
DATA_GOV_MARKET_RESOURCE_ID=
DATA_GOV_CROP_RESOURCE_ID=

# Lightweight cache expiry configurations
CACHE_TTL_SECONDS=86400

# Mode configuration for data execution: REAL_DATA_MODE, DEMO_MODE, TEST_MODE
# - REAL_DATA_MODE: strict ingestion of government APIs, no simulation fallback
# - DEMO_MODE: synthetic mock generator for demo runs
# - TEST_MODE: test configuration runs
TERRAMIND_DATA_MODE=REAL_DATA_MODE

# n8n Automation configurations
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here

# Frontend Vite Backend API URL (defaults to window.location.origin or http://localhost:8000 if unset)
VITE_API_BASE_URL=http://localhost:8000

NASA_POWER_BASE_URL=
MARKET_API_BASE_URL=
MARKET_API_KEY=

LANGGRAPH_ENABLED=true
NVIDIA_ENABLED=true
N8N_ENABLED=true
OFFLINE_FALLBACK_ENABLED=true

